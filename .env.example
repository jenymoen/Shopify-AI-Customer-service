# Kopier denne filen til .env og fyll inn faktiske verdier.
# Aldri commit .env eller reelle secrets. Se ARCHITECTURE.md for begrunnelse per valg.

# --- Database (Neon Postgres + pgvector, se ARCHITECTURE.md §1) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Non-pooled connection (Neon: host without "-pooler"), used by prisma migrate for advisory locks
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Shopify app-legitimasjon ---
# Hentes fra Partner Dashboard / Dev Dashboard når appen er koblet: `npm run config:link`
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Komma-separert liste over Shopify Admin API-scopes (least privilege, se SECURITY.md)
SCOPES=read_customers,read_orders,read_products
# Full URL appen er tilgjengelig på (ngrok/Cloudflare tunnel i dev, faktisk domene i prod)
SHOPIFY_APP_URL=
# Kun ved custom shop-domene
SHOP_CUSTOM_DOMAIN=

# --- Sesjon / auth (agent-portal, §6.2) ---
# Signerer/krypterer portal session-cookies (separat fra Shopify OAuth). Min. 32 tilfeldige byte.
SESSION_SECRET=
# AES-256-GCM-nøkkel (32 byte, base64) for å kryptere Shopify access tokens og andre secrets i DB.
ENCRYPTION_KEY=
# Salt/secret brukt når single-use tokens (magic link, invitasjon, collaborator) hashes før lagring.
TOKEN_HASH_SECRET=

# --- E-post (§10) — Postmark, se ARCHITECTURE.md §1 ---
EMAIL_PROVIDER=postmark
EMAIL_API_KEY=
# Verifiserer at inbound webhook-forespørsler faktisk kommer fra Postmark.
EMAIL_INBOUND_WEBHOOK_SECRET=
# Postmark inbound-adresse som butikkenes support-adresser videresendes til (vises på Email settings).
EMAIL_INBOUND_ADDRESS=
# Fallback-avsenderadresse når butikken ikke har konfigurert egen supportidentitet.
EMAIL_FROM_ADDRESS=

# --- AI-provider (§17) — Anthropic som primær, OpenAI som alternativ implementasjon ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
# Sekundær AIProvider-adapter, kan brukes til A/B/fallback senere. Tom = ikke konfigurert.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# --- Embeddings (§15) — OpenAI text-embedding-3-small (1536 dim, matcher prisma/schema.prisma) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Objektlagring for vedlegg/dokumenter (§4) ---
# "local" i dev (lagrer under STORAGE_LOCAL_PATH), "s3" i prod (AWS S3 eller Cloudflare R2 via samme SDK).
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./.data/attachments
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Kun for R2/S3-kompatible endepunkter som ikke er AWS.
STORAGE_ENDPOINT=

# --- Background job queue (§4, §35) ---
# pg-boss kjører på samme Postgres-instans som DATABASE_URL; ingen egen variabel nødvendig
# med mindre jobb-køen skal ligge i en annen database enn appdataene.
JOB_QUEUE_DATABASE_URL=

# --- Observability (§45) ---
LOG_LEVEL=info
